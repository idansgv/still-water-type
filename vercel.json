{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.idansegev.com" }],
      "destination": "https://idansegev.com/:path*",
      "permanent": true
    },
    {
      "source": "/p/jazz-fan/",
      "destination": "/p/fan/",
      "permanent": true
    },
    {
      "source": "/p/fan-color/",
      "destination": "/p/fan/",
      "permanent": true
    },
    {
      "source": "/p/rigged/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/p/lace/",
      "destination": "/",
      "permanent": false
    }
  ]
}
