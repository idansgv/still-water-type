{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/p/jazz-fan/",
      "destination": "/p/fan/",
      "permanent": true
    },
    {
      "source": "/p/fan-color/",
      "destination": "/p/fan/",
      "permanent": true
    },
    {
      "source": "/p/marbled/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/p/glint/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/p/rigged/",
      "destination": "/",
      "permanent": false
    }
  ]
}
