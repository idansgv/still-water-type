{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug/",
      "has": [{ "type": "query", "key": "n" }],
      "destination": "/api/share?slug=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/p/jazz-fan/",
      "destination": "/p/fan/",
      "permanent": true
    },
    {
      "source": "/p/fan-color/",
      "destination": "/p/fan/",
      "permanent": true
    },
    {
      "source": "/p/rigged/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/p/lace/",
      "destination": "/",
      "permanent": false
    }
  ]
}
